{
  "permissions": {
    "allow": [
      "Bash(firebase login:*)",
      "Bash(/opt/homebrew/bin/gh pr list --state open --json number,title,headRefName)",
      "Bash(/opt/homebrew/bin/gh pr list --state open --json number,title,headRefName,mergeable,mergeStateStatus)",
      "Bash(/opt/homebrew/bin/gh pr list --state open --head release-please--branches--main--components--indii-os --json number,title,mergeable)",
      "Bash(awk '/match \\\\/users\\\\/\\\\{/{f=1} f&&/match \\\\//{print NR\": \"$0} /^    }$/{if\\(f\\)f=0}' packages/firebase/firestore.rules)",
      "Bash(grep -nE \"match /projects/\\\\{|isProjectOwner|projects.*isOwner|allow read, write: if\" packages/firebase/firestore.rules)",
      "Bash(awk '/match \\\\/projects\\\\/\\\\{projectId\\\\}/{f=1} f{print NR\": \"$0} /^      }$/{if\\(f\\){exit}}' packages/firebase/firestore.rules)",
      "Bash(git check-ignore *)",
      "Bash(grep -c \"Re-baselined against the actual codebase\" docs/architecture/BUSINESS_HARNESS_FULL_SUCCESS_PLAN.md)",
      "Bash(grep -c \"Verified Implementation Context\" docs/architecture/APP_RUNTIME_HARNESS_MCP_SKILL_PLAN.md)",
      "Bash(grep -c \"Repo Layout & Policy \\(2026 update\\)\" .agent/skills/hunter/SKILL.md)",
      "Bash(grep -c \"match /agent_audit/{auditId}\\\\|match /web3Contracts/{contractId}\" packages/firebase/firestore.rules)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(firebase --help)",
      "Bash(firebase deploy *)",
      "Bash(git commit -m 'docs: correct Firebase rules validation command in audit doc *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(PLAYWRIGHT_BASE_URL= npx playwright test e2e/conductor-consult-streaming.spec.ts --project=chromium --reporter=line)",
      "Bash(nohup npm run dev:web -- --port 4242)",
      "Bash(echo \"started dev:web pid $!\")",
      "Bash(PLAYWRIGHT_BASE_URL=http://localhost:4242 npx playwright test e2e/conductor-consult-streaming.spec.ts --project=chromium --reporter=line)",
      "Bash(perl -i -pe 's{Agent Zero / Router}{indii Conductor / Router}g; s{`Agent Zero`}{`indii Conductor`}g' docs/flowcharts/file-search-rag.md)",
      "Bash(perl -i -pe 's{packages/renderer/src/modules/music/}{packages/renderer/src/modules/tools/}g' docs/flowcharts/audio-intelligence-flow.md)",
      "Bash(node scripts/validate-flowcharts.js)",
      "Bash(echo \"exit: $?\")"
    ],
    "additionalDirectories": [
      "/Volumes/X SSD 2025/Users/narrowchannel/.claude/plans"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/checkpoint.sh",
            "timeout": 30,
            "statusMessage": "Saving session checkpoint..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/load-context.sh",
            "timeout": 10,
            "statusMessage": "Loading previous session context..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/checkpoint.sh",
            "timeout": 30,
            "statusMessage": "Saving context before compaction..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | grep -E '\\.(ts|tsx)$' | { read -r f; [ -n \"$f\" ] && npx eslint --fix \"$f\" 2>/dev/null || true; }",
            "timeout": 30,
            "statusMessage": "Linting...",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "BRANCH=$(git branch --show-current 2>/dev/null); printf '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"Branch: %s\"}}' \"$BRANCH\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
