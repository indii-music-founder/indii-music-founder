{
  "name": "indii.music",
  "version": "1.64.6",
  "description": "The Operating System for Independent Music — npm Workspace Monorepo",
  "author": "New Detroit Music LLC <info@indii.music>",
  "type": "module",
  "private": true,
  "main": "dist/main/index.js",
  "workspaces": [
    "packages/main",
    "packages/renderer",
    "packages/firebase",
    "packages/shared",
    "packages/landing",
    "packages/sdk",
    "packages/mcp-server-local",
    "packages/mcp-server-harness",
    "packages/admin-dashboard"
  ],
  "scripts": {
    "dev": "npm run preflight:dev && electron-vite dev",
    "dev:web": "npm run preflight:dev && VITE_RENDERER_ONLY=true vite --config packages/renderer/vite.config.ts --port 4243",
    "dev:e2e-mock": "VITE_E2E=true VITE_FIREBASE_E2E_MOCK=true VITE_RENDERER_ONLY=true vite --config packages/renderer/vite.config.ts --port 4242",
    "build": "npm run preflight:prod && electron-vite build",
    "build:ci": "npm run typecheck && npm run lint && electron-vite build",
    "build:studio": "electron-vite build",
    "build:mcp": "npm run build -w packages/mcp-server-local && npm run build -w packages/mcp-server-harness",
    "build:firebase": "npm run build -w packages/firebase",
    "build:landing": "npm run build -w packages/landing",
    "deploy": "npm run preflight:prod && electron-vite build && firebase deploy --only hosting:app",
    "deploy:functions": "npm run build -w packages/firebase && firebase deploy --only functions",
    "deploy:landing": "npm run build -w packages/landing && firebase deploy --only hosting:landing",
    "deploy:all": "npm run preflight:prod && npm run build && npm run build:firebase && npm run build:landing && firebase deploy",
    "typecheck": "tsc -b packages/shared packages/main packages/renderer packages/firebase",
    "lint": "npm run validate:mainline-workflows && eslint packages/main/src packages/renderer/src packages/shared/src packages/firebase/src packages/landing/src packages/sdk/src",
    "validate:mainline-workflows": "node scripts/validate-mainline-workflows.js",
    "security:frontend-api-boundary": "node scripts/guard-frontend-api-boundary.mjs",
    "lint:fix": "eslint packages/main/src packages/renderer/src packages/shared/src packages/firebase/src packages/landing/src packages/sdk/src --fix",
    "lint:renderer": "eslint packages/renderer/src",
    "lint:main": "eslint packages/main/src",
    "typecheck:firebase-tests": "tsc -p packages/firebase/tsconfig.test.json",
    "typecheck:renderer": "tsc -b packages/renderer",
    "typecheck:main": "tsc -b packages/main",
    "test": "vitest",
    "test:ci": "vitest --run",
    "test:renderer": "vitest --project renderer",
    "test:main": "vitest --project main",
    "test:integration": "vitest run \"integration.test\"",
    "test:integration:ci": "vitest run \"integration.test\"",
    "test:e2e": "npx playwright test --project=chromium --grep-invert @live",
    "test:e2e:live": "npx playwright test --project=chromium --grep @live",
    "test:e2e:all": "npx playwright test",
    "test:e2e:emulator": "bash scripts/run-e2e-emulator.sh",
    "test:contracts": "npx playwright test e2e/api-contracts.integration.test.ts --project=chromium",
    "test:generation": "npx playwright test e2e/creative-generation.integration.test.ts --project=chromium",
    "test:initialization": "npx playwright test e2e/service-initialization.integration.test.ts --project=chromium",
    "test:payloads": "npx playwright test e2e/payload-validation.integration.test.ts --project=chromium",
    "test:async": "npx playwright test e2e/async-error-handling.integration.test.ts --project=chromium",
    "test:api": "npm run test:contracts && npm run test:generation && npm run test:initialization && npm run test:payloads && npm run test:async",
    "test:api:ci": "CI=true npm run test:api -- --run",
    "detect:bugs": "bash scripts/detect-hidden-bugs.sh",
    "check:dep-drift": "node scripts/check-dep-version-drift.cjs",
    "check:dep-integrity": "node scripts/check-dependency-integrity.cjs",
    "test:rules": "FIRESTORE_EMULATOR_HOST=localhost:8080 vitest run --config vitest.rules.config.ts",
    "emulator:functions": "firebase emulators:start --only functions",
    "health:check": "sh -c 'files=$(find packages/renderer/src/services -name \"*.integration.test.ts\" -print); if [ -z \"$files\" ]; then echo \"No integration tests found\"; exit 0; fi; vitest run $files'",
    "health:generate-dashboard": "tsx scripts/generate-health-dashboard.ts",
    "clean": "rm -rf dist dist-electron packages/*/dist .firebase .genkit coverage test-results playwright-report",
    "validate": "node scripts/check-test-quality.js && npm run security:frontend-api-boundary && npm run lint && npm run typecheck && npm run test -- --run",
    "nuke": "rm -rf node_modules packages/*/node_modules package-lock.json && npm install",
    "build:desktop": "npm run preflight:prod && electron-vite build && electron-builder --publish never",
    "build:desktop:mac": "npm run preflight:prod && electron-vite build && electron-builder --mac --publish never",
    "build:desktop:win": "npm run preflight:prod && electron-vite build && electron-builder --win --publish never",
    "build:desktop:linux": "npm run preflight:prod && electron-vite build && electron-builder --linux --publish never",
    "doctor": "bash scripts/doctor.sh",
    "scripts": "cat scripts/SCRIPTS_CATALOG.md",
    "scripts:help": "cat scripts/SCRIPTS_CATALOG.md",
    "changelog": "bash scripts/generate-changelog.sh",
    "changelog:update": "bash scripts/generate-changelog.sh --prepend",
    "storybook": "npm run storybook -w packages/renderer",
    "storybook:build": "npm run build-storybook -w packages/renderer",
    "prepare": "husky",
    "bootstrap": "npm install && cp -n .env.example .env 2>/dev/null || true && npm run typecheck",
    "ci": "bash scripts/ci.sh",
    "preflight:dev": "node --import tsx scripts/production-gate.ts --dev",
    "preflight:prod": "node --import tsx scripts/production-gate.ts --prod"
  },
  "devDependencies": {
    "@ai-sdk/google": "^3.0.60",
    "@axe-core/playwright": "^4.11.1",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.8",
    "axe-core": "4.11.1",
    "dotenv": "^17.2.3",
    "electron": "^41.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "firebase-functions-test": "^3.5.0",
    "firebase-tools": "15.22.3",
    "globals": "16.5.0",
    "husky": "^9.1.7",
    "jsdom": "26.1.0",
    "lightningcss": "1.30.2",
    "lint-staged": "^16.4.0",
    "ts-deepmerge": "8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.48.0",
    "utf-8-validate": "^5.0.2",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.25.12",
    "@rollup/rollup-linux-x64-gnu": "4.53.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.1.18",
    "canvas": "3.2.0",
    "cpu-features": "0.0.10",
    "lightningcss-linux-x64-gnu": "1.30.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "com.indii.music",
    "productName": "indii.music",
    "directories": {
      "output": "dist-electron"
    },
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**"
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/@rollup/rollup-linux-x64-gnu",
      "!node_modules/@esbuild"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "gatekeeperAssess": true,
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "npmRebuild": false,
    "protocols": [
      {
        "name": "indii",
        "schemes": [
          "indii"
        ]
      }
    ],
    "publish": [
      {
        "owner": "indii-music-founder",
        "provider": "github",
        "repo": "indii-music-founder",
        "releaseType": "release"
      }
    ],
    "win": {
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}",
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "zod": "3.25.76",
    "@genkit-ai/firebase": "1.26.0",
    "@genkit-ai/google-cloud": "1.26.0",
    "fast-xml-parser": "^5.9.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uuid": "11.1.1",
    "ts-deepmerge": "8.0.0",
    "firebase-admin": "13.10.0",
    "@opentelemetry/core": "^2.9.0"
  },
  "lint-staged": {
    "package.json": [
      "node --import tsx scripts/production-gate.ts --dev"
    ],
    "packages/renderer/src/**/*.{ts,tsx}": [
      "eslint"
    ],
    "packages/main/src/**/*.{ts,tsx}": [
      "eslint"
    ],
    "packages/shared/src/**/*.{ts,tsx}": [
      "eslint"
    ],
    "packages/firebase/src/**/*.{ts,tsx}": [
      "eslint"
    ],
    "packages/landing/src/**/*.{ts,tsx}": [
      "eslint"
    ],
    "packages/mcp-server-local/src/**/*.{ts,tsx}": [
      "eslint"
    ]
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/indii-music-founder/indii-music-founder.git"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@ngrok/ngrok": "^1.7.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "bufferutil": "^4.1.0",
    "chokidar": "^5.0.0",
    "electron-log": "5.4.3",
    "electron-squirrel-startup": "1.0.1",
    "electron-store": "11.0.2",
    "electron-updater": "^6.8.3",
    "express": "4.22.2",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "firebase-admin": "13.10.0",
    "fluent-ffmpeg": "2.1.3",
    "jspdf": "^4.2.1",
    "keytar": "7.9.0",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.17.0",
    "resend": "6.1.3",
    "ssh2-sftp-client": "12.0.1",
    "stripe": "20.1.2",
    "utf-8-validate": "^5.0.2",
    "vite": "6.4.3",
    "ws": "8.21.0"
  }
}
