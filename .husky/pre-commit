#!/bin/bash

# Platinum Quality Gate: Pre-commit Hook
# Prevents commits that violate code quality standards

set -e

echo "🔐 Running pre-commit quality gates..."

# Stage 1: Lint all staged files
echo "  1️⃣  Linting staged files..."
npx lint-staged --quiet

# Stage 2: Type check (quick check of current project)
echo "  2️⃣  Type checking..."
npm run typecheck > /dev/null 2>&1 || {
  echo "  ❌ Type errors detected. Fix them and try again."
  npm run typecheck
  exit 1
}

# Stage 3: Verify no security boundary violations
echo "  3️⃣  Checking API security boundaries..."
npm run security:frontend-api-boundary > /dev/null 2>&1 || {
  echo "  ❌ Security boundary violation detected."
  exit 1
}

# Stage 3a: Verify agent capability catalog is up to date
echo "  3️⃣ a Checking agent capability catalog..."
npm run validate:capabilities > /dev/null 2>&1 || {
  echo "  ❌ Capability catalog is stale. Run 'npm run capabilities:generate' and stage the catalog."
  exit 1
}

# Stage 3b: Cloud Function runtime invariants (ISSUE-1238, ISSUE-1242, ISSUE-1243)
# Two failure modes that no type error or failing test catches, because they
# only differ in production: a function pinned below the ~259MiB shared
# cold-start floor (which fails the ENTIRE functions deploy), and a Gen1->Gen2
# migrated export that silently picked up Gen2's concurrency-80 default instead
# of Gen1's one-request-per-instance behavior.
echo "  3️⃣ b Checking Cloud Function runtime invariants..."
npm run check:functions > /dev/null 2>&1 || {
  echo "  ❌ Cloud Function runtime invariant violated."
  npm run check:functions
  exit 1
}

# Stage 4: Run affected unit tests (CRITICAL: Closes the pre-commit gap)
# If any .ts/.tsx source files are staged, run their corresponding tests.
# This catches broken assertions, type mismatches, mock/stub issues before commit.
# Enforces: "rename → run tests → commit", not "commit → tests fail in CI"
echo "  4️⃣  Running affected unit tests..."
STAGED_SOURCE=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -v '\.test\.' | grep -v 'node_modules' | head -50)
if [ -n "$STAGED_SOURCE" ]; then
  TEST_FILES=""
  for FILE in $STAGED_SOURCE; do
    # Convert packages/renderer/src/services/foo/Bar.ts → packages/renderer/src/services/foo/Bar.test.ts
    TEST_FILE="${FILE%.ts}.test.ts"
    TEST_FILE="${TEST_FILE%.tsx}.test.tsx"
    if [ -f "$TEST_FILE" ]; then
      TEST_FILES="$TEST_FILES $TEST_FILE"
    fi
  done

  if [ -n "$TEST_FILES" ]; then
    echo "    Testing: $(echo $TEST_FILES | wc -w) files"
    npm test -- --run $TEST_FILES > /dev/null 2>&1 || {
      echo "  ❌ Unit test failures in affected files. Fix and retry:"
      npm test -- --run $TEST_FILES
      exit 1
    }
  fi
fi

echo "  ✅ All pre-commit gates passed!"
exit 0
