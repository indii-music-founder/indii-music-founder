{
    "compileOnSave": true,
    "compilerOptions": {
        "baseUrl": ".",
        "composite": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "noImplicitReturns": true,
        "noUnusedLocals": false,
        "outDir": "lib",
        "rootDir": "src",
        "tsBuildInfoFile": "lib/.tsbuildinfo",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ES2022",
        "ignoreDeprecations": "5.0"
    },
    "exclude": [
        "src/__tests__",
        "src/**/*.test.ts",
        "src/**/*.test.*.ts"
    ],
    "include": [
        "src"
    ],
    "references": [
        {
            "path": "../shared"
        }
    ]
}
