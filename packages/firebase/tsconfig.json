{
    "compileOnSave": true,
    "compilerOptions": {
        "baseUrl": ".",
        "composite": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "noImplicitReturns": true,
        "noUnusedLocals": false,
        "outDir": "lib",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "es2017"
    },
    "exclude": [
        "src/__tests__",
        "src/**/*.test.ts"
    ],
    "include": [
        "src"
    ]
}
