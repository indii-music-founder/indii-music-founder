{
    "compileOnSave": true,
    "compilerOptions": {
        "baseUrl": ".",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "outDir": "lib",
        "paths": {
            "@indii/shared": ["../shared/src/index.ts"]
        },
        "rootDir": ".",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "es2017"
    },
    "exclude": [
        "src/__tests__",
        "src/**/*.test.ts"
    ],
    "include": [
        "src"
    ]
}