{
    "compileOnSave": true,
    "compilerOptions": {
        "baseUrl": ".",
        "composite": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "noImplicitReturns": true,
        "noUnusedLocals": false,
        "outDir": "lib",
        "rootDir": "src",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "es2020",
        "lib": ["es2020", "dom"],
        "ignoreDeprecations": "5.0"
    },
    "include": ["src/**/*.ts", "../shared/src/foundry/**/*.ts"],
    "exclude": ["src/__tests__", "src/**/*.test.ts"]
    "paths": {
      "@shared/*": ["../shared/src/*"]
    }

}
