rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================
    
    // Check if user is authenticated (and NOT anonymous)
    function isAuthenticated() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    // Check if user is authenticated with email (not anonymous)
    function isEmailAuthenticated() {
      return isAuthenticated() && request.auth.token.email != null;
    }
    
    // Check if user is admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    // Guest explorer writes are retired. Keep this helper so legacy rule branches
    // stay syntactically stable, but make every guest path fail closed.
    function isGuest() {
      return false;
    }
    
    // Check if user owns this resource
    function isOwner(userId) {
      return (isAuthenticated() && request.auth.uid == userId) || (userId == 'founder-demo-uid' && isGuest());
    }

    // Root collections are often scoped by an ownership field instead of by
    // their document path. Every client-authorized update must pin all fields
    // that can affect ownership, organization membership, or collaborator
    // authority. Otherwise a valid owner can rewrite the post-update document
    // into another user's query namespace.
    function authorityFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'userId',
        'ownerId',
        'ownerUid',
        'orgId',
        'authorId',
        'initiatorUid',
        'requestedBy',
        'labelId',
        'createdBy',
        'members',
        'parties'
      ]);
    }

    function clientIdentityFieldsMatchCaller() {
      return (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
        (!('ownerId' in request.resource.data) || request.resource.data.ownerId == request.auth.uid) &&
        (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid) &&
        (!('authorId' in request.resource.data) || request.resource.data.authorId == request.auth.uid) &&
        (!('initiatorUid' in request.resource.data) || request.resource.data.initiatorUid == request.auth.uid) &&
        (!('requestedBy' in request.resource.data) || request.resource.data.requestedBy == request.auth.uid) &&
        (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid) &&
        (
          !('orgId' in request.resource.data) ||
          request.resource.data.orgId == null ||
          request.resource.data.orgId in ['personal', 'org-default', request.auth.uid] ||
          (
            request.resource.data.orgId is string &&
            isOrgMember(request.resource.data.orgId)
          )
        ) &&
        (
          !('labelId' in request.resource.data) ||
          request.resource.data.labelId == request.auth.uid ||
          (
            request.resource.data.labelId is string &&
            isOrgMember(request.resource.data.labelId)
          )
        );
    }

    function ownerCreateIsValid(ownerField) {
      return isAuthenticated() &&
        request.resource.data.get(ownerField, null) == request.auth.uid &&
        clientIdentityFieldsMatchCaller();
    }

    function ownerUpdateIsValid(ownerField) {
      return isAuthenticated() &&
        resource.data.get(ownerField, null) == request.auth.uid &&
        request.resource.data.get(ownerField, null) == resource.data.get(ownerField, null) &&
        authorityFieldsUnchanged();
    }

    function orgUpdateIsValid() {
      return isAuthenticated() &&
        resource.data.get('orgId', null) is string &&
        isOrgMember(resource.data.orgId) &&
        request.resource.data.get('orgId', null) == resource.data.orgId &&
        authorityFieldsUnchanged();
    }

    function ownerOrOrgUpdateIsValid() {
      return ownerUpdateIsValid('userId') || orgUpdateIsValid();
    }

    function ownerOrOrgCreateIsValid() {
      return ownerCreateIsValid('userId') ||
        (
          isAuthenticated() &&
          request.resource.data.get('orgId', null) is string &&
          isOrgMember(request.resource.data.orgId) &&
          clientIdentityFieldsMatchCaller()
        );
    }

    function profileAuthorityFieldsUnchanged() {
      return authorityFieldsUnchanged() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'role',
          'roles',
          'isAdmin',
          'permissions',
          'tier',
          'subscriptionTier',
          'plan',
          'isFounder',
          'entitlements',
          'credits',
          'creditBalance',
          'billing',
          'stripeCustomerId'
        ]);
    }

    // Check if user is member of organization
    function isOrgMember(orgId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        request.auth.uid in get(/databases/$(database)/documents/organizations/$(orgId)).data.members;
    }
    
    // Check if user is owner of organization
    function isOrgOwner(orgId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == request.auth.uid;
    }

    function canReadReleaseCollection(collectionName, releaseId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/$(collectionName)/$(releaseId)) &&
        (
          get(/databases/$(database)/documents/$(collectionName)/$(releaseId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/$(collectionName)/$(releaseId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/$(collectionName)/$(releaseId)).data.createdBy == request.auth.uid ||
          (
            ('orgId' in get(/databases/$(database)/documents/$(collectionName)/$(releaseId)).data) &&
            get(/databases/$(database)/documents/$(collectionName)/$(releaseId)).data.orgId != null &&
            isOrgMember(get(/databases/$(database)/documents/$(collectionName)/$(releaseId)).data.orgId)
          )
        );
    }

    function canReadDistributionRelease(releaseId) {
      return canReadReleaseCollection('proprietaryIngestionReleases', releaseId) ||
        canReadReleaseCollection('ddexReleases', releaseId) ||
        canReadReleaseCollection('releases', releaseId);
    }

    // Validate string field
    function isValidString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    function isValidRemoteRelayMetadata(metadata) {
      return metadata is map &&
        metadata.keys().hasOnly(['aspectRatio', 'type', 'entryCommandId', 'source']) &&
        (!('aspectRatio' in metadata) || isValidString(metadata.aspectRatio, 1, 16)) &&
        (!('type' in metadata) || isValidString(metadata.type, 1, 64)) &&
        (!('entryCommandId' in metadata) || isValidString(metadata.entryCommandId, 1, 80)) &&
        (!('source' in metadata) || isValidString(metadata.source, 1, 40));
    }

    function isValidRemoteRelayCommand(data) {
      return data.keys().hasOnly([
          'text',
          'targetAgentId',
          'metadata',
          'executionTarget',
          'timestamp',
          'status',
          'createdAt',
          'executorId',
          'executorDeviceId',
          'claimedAt',
          'completedAt'
        ]) &&
        data.keys().hasAll(['text', 'executionTarget', 'timestamp', 'status', 'createdAt']) &&
        isValidString(data.text, 1, 20000) &&
        data.executionTarget in ['cloud', 'studio'] &&
        data.status in ['pending', 'processing', 'completed', 'cancelled'] &&
        data.timestamp is timestamp &&
        data.createdAt is timestamp &&
        (!('targetAgentId' in data) || isValidString(data.targetAgentId, 1, 100)) &&
        (!('metadata' in data) || isValidRemoteRelayMetadata(data.metadata)) &&
        (!('executorId' in data) || isValidString(data.executorId, 16, 128)) &&
        (!('executorDeviceId' in data) || isValidString(data.executorDeviceId, 16, 128)) &&
        (!('claimedAt' in data) || data.claimedAt is timestamp) &&
        (!('completedAt' in data) || data.completedAt is timestamp);
    }

    function isValidRemoteSleepSettings(data) {
      return data.keys().hasOnly(['sleepEnabled', 'autoSleepMinutes', 'updatedAt']) &&
        data.keys().hasAll(['sleepEnabled', 'autoSleepMinutes', 'updatedAt']) &&
        data.sleepEnabled is bool &&
        data.autoSleepMinutes in [0, 15, 30, 60] &&
        data.updatedAt is timestamp;
    }

    function isValidEntryCommand(data, ownerId, scope) {
      return data.keys().hasOnly([
          'id',
          'slash',
          'aliases',
          'title',
          'summary',
          'surfaces',
          'intakeFields',
          'harnessDomain',
          'workflowId',
          'launchMode',
          'outputContract',
          'approvalRequiredFor',
          'resumeBehavior',
          'isCustom',
          'createdAt',
          'sourceSummary',
          'ownerId',
          'scope',
          'orgId',
          'updatedAt'
        ]) &&
        data.keys().hasAll([
          'id',
          'slash',
          'aliases',
          'title',
          'summary',
          'surfaces',
          'intakeFields',
          'launchMode',
          'outputContract',
          'approvalRequiredFor',
          'resumeBehavior',
          'isCustom',
          'ownerId',
          'scope',
          'updatedAt'
        ]) &&
        data.id is string &&
        data.id.size() >= 3 &&
        data.id.size() <= 80 &&
        data.slash is string &&
        data.slash.matches("^/[a-z][a-z0-9-]{1,31}$") &&
        data.aliases is list &&
        data.aliases.size() <= 12 &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 80 &&
        data.summary is string &&
        data.summary.size() >= 1 &&
        data.summary.size() <= 280 &&
        data.surfaces is list &&
        data.surfaces.size() >= 1 &&
        data.surfaces.size() <= 5 &&
        data.surfaces.hasOnly(['dashboard', 'command-bar', 'mobile', 'capture', 'voice']) &&
        data.intakeFields is list &&
        data.intakeFields.size() <= 12 &&
        data.launchMode in ['guided-chat', 'navigate', 'workflow'] &&
        data.outputContract is string &&
        data.outputContract.size() >= 1 &&
        data.outputContract.size() <= 400 &&
        data.approvalRequiredFor is list &&
        data.approvalRequiredFor.size() <= 12 &&
        data.resumeBehavior is string &&
        data.resumeBehavior.size() >= 1 &&
        data.resumeBehavior.size() <= 300 &&
        data.isCustom == true &&
        data.ownerId == ownerId &&
        data.scope == scope &&
        data.updatedAt is number &&
        (!('createdAt' in data) || data.createdAt is number) &&
        (!('sourceSummary' in data) || (data.sourceSummary is string && data.sourceSummary.size() <= 1500)) &&
        (!('harnessDomain' in data) || data.harnessDomain in [
          'artist_memory',
          'song_dna',
          'creator_protection',
          'distribution_ddex',
          'release',
          'finance',
          'activity_time_value',
          'road_travel',
          'gear_asset',
          'merch_pod',
          'marketing_growth',
          'fan_crm',
          'publishing_rights',
          'collaboration_splits',
          'licensing_sync',
          'royalty_revenue',
          'legal_compliance',
          'creative_production',
          'opportunity',
          'education_curriculum',
          'security_trust',
          'boardroom_meta'
        ]) &&
        (!('workflowId' in data) || (data.workflowId is string && data.workflowId.size() <= 80));
    }

    // =========================================================================
    // User Profiles
    // =========================================================================
    match /users/{userId} {
      // This document contains private identity and billing-adjacent fields,
      // including email. Public artist discovery must use a separately shaped
      // public projection; client-side redaction cannot protect fields already
      // returned by Firestore to an arbitrary reader.
      allow read: if isOwner(userId) || (isGuest() && userId == 'founder-demo-uid');

      // Users can create their own profile
      allow create: if isOwner(userId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('userId' in request.resource.data) || request.resource.data.userId == userId) &&
        (!('ownerId' in request.resource.data) || request.resource.data.ownerId == userId) &&
        (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == userId) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        !('roles' in request.resource.data) &&
        !('permissions' in request.resource.data) &&
        !('tier' in request.resource.data) &&
        !('subscriptionTier' in request.resource.data) &&
        !('plan' in request.resource.data) &&
        !('isFounder' in request.resource.data) &&
        !('entitlements' in request.resource.data) &&
        !('credits' in request.resource.data) &&
        !('creditBalance' in request.resource.data) &&
        !('billing' in request.resource.data) &&
        !('stripeCustomerId' in request.resource.data) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['artist', 'user']);

      // Users can update their own profile with validation
      allow update: if isOwner(userId) &&
        profileAuthorityFieldsUnchanged() &&
        // Prevent changing uid
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid']) ||
         (!('uid' in resource.data) && request.resource.data.uid == userId));

      // Users cannot delete their profile (admin action only)
      allow delete: if false;

      // ── User Stats (Dashboard Analytics) ──────────────────────────
      match /stats/{statId} {
        allow read: if isOwner(userId) || (isGuest() && userId == 'founder-demo-uid');
        allow write: if false; // Stats should be updated via backend functions
      }

      // Server-owned, per-creator cost aggregates. Clients may inspect only
      // their own receipt; reservations and refunds are callable/admin-only.
      match /costLedger/{ledgerId} {
        allow read: if isOwner(userId) || (isGuest() && userId == 'founder-demo-uid');
        allow write: if false;
      }

      // Server-issued account access. The browser can inspect its current
      // entitlement and immutable grant evidence, but cannot create, modify,
      // downgrade, or self-upgrade either document. Firebase Functions use the
      // Admin SDK after verifying Firebase Auth email state or payment evidence.
      match /entitlements/{entitlementId} {
        allow read: if isOwner(userId) && entitlementId == 'current';
        allow create, update, delete: if false;
      }

      match /entitlementAudit/{grantId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // Owner-isolated RAG Knowledge Base collections. Metadata, chunks, query logs,
      // and indexing receipts are owned by userId. Chunks, receipts, and query logs
      // are created/managed strictly server-side by authenticated Cloud Functions.
      match /ragDocuments/{documentId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if false;
      }

      match /ragChunks/{chunkId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /ragQueries/{queryId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /ragReceipts/{receiptId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // OAuth credentials and transient OAuth selection intents are backend-only.
      // The client receives safe connection metadata through authenticated callables.
      match /analyticsTokens/{platform} {
        allow read, write: if false;
      }

      match /socialTokens/{platform} {
        allow read, write: if false;
      }

      match /serverSocialConnectionIntents/{intentId} {
        allow read, write: if false;
      }

      // ── Audio Asset Library (Generated/Uploaded Audio) ──────────────────
      // Audio assets with playable Storage URLs or bounded data URIs.
      // Schema validation: type in ['soundfx', 'music', 'tts'], duration 0-7200s,
      // prompt/mimeType required, storageUrl or dataUri (bounded ≤1MiB), userId consistency.
      match /audio_assets/{assetId} {
        function isValidAudioAsset() {
          return request.resource.data.get('type', '') in ['soundfx', 'music', 'tts'] &&
            request.resource.data.get('duration', -1) >= 0 &&
            request.resource.data.get('duration', 7201) <= 7200 &&
            request.resource.data.get('prompt', '') is string &&
            request.resource.data.get('mimeType', '') is string &&
            (request.resource.data.get('storageUrl', null) != null ||
             (request.resource.data.get('dataUri', null) != null &&
              request.resource.data.dataUri.size() <= 1048576)) &&
            request.resource.data.get('timestamp', 0) > 0 &&
            request.resource.data.get('userId', '') == request.auth.uid;
        }
        allow read: if isOwner(request.resource.data.get('userId', ''));
        allow create: if isAuthenticated() && isValidAudioAsset();
        allow update: if false; // Audio assets are immutable
        allow delete: if isOwner(resource.data.get('userId', ''));
      }

      // ── Platform Stats Cache (Social Analytics) ──────────────────────────
      // Cache of fetched platform statistics. Server writes via Admin SDK;
      // client reads only. Platform stats are derived from socialTokens
      // but expose no token details to the client.
      match /platformStats/{platform} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // ── Merchandise Mockups (Commerce) ────────────────────────────────────
      // AI-generated product mockup previews, written by CommerceTools.mockup_merchandise.
      // Preview-only records (readyForPOD is always false at this stage) — owner
      // read/write, immutable once created (regenerate instead of editing).
      match /merchandiseMockups/{mockupId} {
        function isValidMerchandiseMockup() {
          return request.resource.data.get('productType', '') is string &&
            request.resource.data.get('productType', '').size() >= 1 &&
            request.resource.data.get('designIdea', '') is string &&
            request.resource.data.get('imageUrl', '') is string &&
            request.resource.data.get('imageUrl', '').size() >= 1;
        }
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerifiedUser() && isValidMerchandiseMockup();
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      // ── Brand Kit (Brand consistency tooling) ─────────────────────────────
      // Single document at 'current', written by BrandTools.save_brand_kit via
      // setDoc(..., {merge: true}). Owner-only; no server-owned fields to protect.
      match /brandKit/{docId} {
        function isValidBrandKit() {
          return docId == 'current' &&
            request.resource.data.get('name', '') is string &&
            request.resource.data.get('values', []) is list;
        }
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isVerifiedUser() && isValidBrandKit();
        allow delete: if isOwner(userId);
      }

      // ── Tax Collaborators (Finance/W9/W8BEN) ──────────────────────────────
      // Collaborators for tax form collection. Owner manages list; backend
      // handles form uploads to Storage and Firestore documents.
      match /tax_collaborators/{collaboratorId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly([
            'id', 'name', 'email', 'country', 'formType', 'status',
            'uploadedAt', 'fileName', 'storagePath', 'requestedAt',
            'consumedToken', 'consumedAt', 'reviewedAt', 'on_file'
          ]);
        allow delete: if isOwner(userId);
      }

      // ── Marketing swarm activity feed ────────────────────────────────────
      // Written only by the ad executor (Admin SDK, bypasses rules). The owner
      // reads it to watch agents act on their behalf; a client-forged entry
      // would be an artist "seeing" an ad buy that never happened, so writes
      // are closed. The immutable audit copy lives in timelineExecutionLogs,
      // which no client can reach at all.
      match /marketingAgentLogs/{logId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // ── Memory Inbox (agent handshake requests) ──────────────────────────
      match /memoryInbox/{itemId} {
        // Only the owning user can read their inbox items
        allow read: if isOwner(userId);
        // Agent backend writes new handshake requests; user can update status only
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if false;
      }

      // =========================================================================
      // Cross-Device Handoff & User Settings (user-scoped subcollection)
      // HandoffService writes to: users/{uid}/settings/handoff
      // =========================================================================
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          (settingId != 'remoteSettings' || isValidRemoteSleepSettings(request.resource.data));
        allow delete: if false;
      }

      // Layer 1: Session Transcripts — Durable session history for Squeezer search
      match /session_transcripts/{sessionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if false;
      }

      // Layer 2: Deep Hive — Episodic memory store
      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if false;
      }

      // Layer 2: Deep Hive — Consolidated insights
      match /insights/{insightId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if false;
      }

      // AlwaysOnMemoryEngine — Always-on memory ingestion & consolidation
      match /knowledge_wiki/{docId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /alwaysOnMemories/{memoryId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /consolidationInsights/{insightId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /ingestionEvents/{eventId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      // =========================================================================
      // Remote Relay (Firestore Cloud Relay — phone ↔ desktop)
      // =========================================================================
      // Desktop state document
      match /remote-relay/{docId} {
        allow read: if isOwner(userId);
        // Diagnostics remain owner-writable.
        allow create, update: if isOwner(userId) && docId != 'state';
        // Trusted Studio presence is projected only by publishStudioPresence after
        // the server validates the short-lived executor lease and its expiry.
        allow create, update: if false;
        allow delete: if isOwner(userId) && docId != 'state';
      }

      // Server-owned lease records. Their token is intentionally unreadable
      // from the client; only the callable can exchange an Electron keychain
      // enrollment credential for a short-lived token.
      match /studioExecutors/{deviceId} {
        allow read, write: if false;
      }

      // Commands (phone writes, desktop reads/updates) — ephemeral relay docs
      match /remote-relay-commands/{commandId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasOnly([
            'text', 'targetAgentId', 'metadata', 'executionTarget',
            'timestamp', 'status', 'createdAt'
          ]) &&
          request.resource.data.status == 'pending' &&
          isValidRemoteRelayCommand(request.resource.data);
        // A Controller may cancel its own still-pending request, but cannot
        // mutate its payload, claim, complete, or otherwise impersonate an
        // executor. Validate the full post-update document to close the usual
        // create-valid/update-invalid bypass.
        allow update: if isOwner(userId) &&
          resource.data.get('status', null) == 'pending' &&
          request.resource.data.get('status', null) == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          isValidRemoteRelayCommand(request.resource.data);
        allow delete: if isOwner(userId) && resource.data.get('executionTarget', 'cloud') != 'studio';
      }

      // Responses (desktop writes, phone reads) — ephemeral relay docs
      match /remote-relay-responses/{responseId} {
        allow read: if isOwner(userId);
        // Studio and cloud responses are written by trusted server functions
        // after executor validation; a Controller cannot forge completion.
        allow write: if false;
      }

      // =========================================================================
      // Workspace Sync (Cross-Device State Replication)
      // =========================================================================
      // Workspace snapshot document (users push/pull workspace state here)
      match /workspace/{docId} {
        allow read, write: if isOwner(userId);
      }

      // User-selected local folders. Paths are owner-only metadata and never
      // grant a Cloud Function or another user filesystem access.
      match /desktopAssetFolders/{folderId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /screenwriterDrafts/{draftId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.get('ownerId', userId) == userId &&
          request.resource.data.get('projectId', draftId) == draftId;
        allow delete: if isOwner(userId);
      }

      match /contracts/{contractId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /contract_analyses/{analysisId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /emailAccounts/{accountId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /syncBriefs/{briefId} {
        allow read, write: if isOwner(userId);
      }

      match /styleMemory/{memoryId} {
        allow read, write: if isOwner(userId);
      }

      // ── Media & Workflow Assets ──────────────────────────
      match /generated_videos/{vidId} { allow read, write: if isOwner(userId); }
      match /generated_images/{imgId} { allow read, write: if isOwner(userId); }
      match /analyzed_tracks/{trackId} { allow read, write: if isOwner(userId); }
      match /neural_cortex/{cortexId} { allow read, write: if isOwner(userId); }
      match /knowledge_base/{docId} { allow read, write: if isOwner(userId); }
      // DEPRECATED: Dual project paths. Use root /projects collection instead.
      // match /projects/{projId} { allow read, write: if isOwner(userId); }
      match /assets/{assetId} { allow read, write: if isOwner(userId); }
      match /tracks/{trackId} { allow read, write: if isOwner(userId); }

      // ── Owner-scoped subcollections (2026-05-28: latent 403 fixes — see docs/architecture/FIRESTORE_RULES_403_AUDIT.md) ──
      match /agent_audit/{auditId} { allow read, write: if isOwner(userId); }
      match /agent_dispatch_queue/{taskId} { allow read, write: if isOwner(userId); }
      match /browserHistory/{entryId} { allow read, write: if isOwner(userId); }
      match /computerSessions/{sessionId} { allow read, write: if isOwner(userId); }
      match /contacts/{contactId} { allow read, write: if isOwner(userId); }
      match /crisis_responses/{responseId} { allow read, write: if isOwner(userId); }
      match /email_pitches/{pitchId} { allow read, write: if isOwner(userId); }
      match /fanPurchases/{purchaseId} { allow read, write: if isOwner(userId); }
      match /fieldContacts/{contactId} { allow read, write: if isOwner(userId); }
      match /fineTuningDataset/{exampleId} { allow read, write: if isOwner(userId); }
      match /licensingDeals/{dealId} { allow read, write: if isOwner(userId); }
      match /likeness/{likenessId} { allow read, write: if isOwner(userId); }
      match /notifications/{notificationId} { allow read, write: if isOwner(userId); }
      match /pod_orders/{orderId} { allow read, write: if isOwner(userId); }
      match /press_releases/{prId} { allow read, write: if isOwner(userId); }
      match /publishingCatalog/{compositionId} { allow read, write: if isOwner(userId); }
      match /tasks/{taskId} { allow read, write: if isOwner(userId); }
      match /tool_approvals/{approvalId} { allow read, write: if isOwner(userId); }
      match /aop/{docId} { allow read, write: if isOwner(userId); }
      match /web3Contracts/{contractId} { allow read, write: if isOwner(userId); }

      // ── Usage Tracking (MembershipService daily quota / budget) ──────
      match /usage/{dateKey} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        // Allow atomic counter increments (increment() uses updateDoc / setDoc merge)
        allow update: if isOwner(userId);
        // Usage records are retained for billing audit — no client-side deletion
        allow delete: if false;
      }

      // ── Visual Autorater Audit Logs (Item 409) ──────────────────────────
      match /visualVerifications/{traceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if false; // Audits are permanent records
      }

      match /releaseHarnessRuns/{runId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /harnessRuns/{runId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /businessActivityEvents/{eventId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /businessCostLines/{costLineId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /identityProtectionProfiles/{profileId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /replicaIncidents/{incidentId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /evidencePackets/{packetId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /takedownCases/{caseId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }
    }

    // =========================================================================
    // Organizations
    // =========================================================================
    match /organizations/{orgId} {
      // Members can read org data. Do NOT use get() here to allow query execution.
      allow read: if (isAuthenticated() && request.auth.uid in resource.data.members) || isGuest();
      
      // Authenticated users with email can create orgs
      allow create: if (isEmailAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in request.resource.data.members) || isGuest();
      
      // Only org owner can update
      allow update: if (isVerifiedUser() && resource.data.ownerId == request.auth.uid &&
        // Cannot change owner without explicit transfer
        request.resource.data.ownerId == resource.data.ownerId) || isGuest();
      
      // Delete always denied
      allow delete: if false;
      
      // Projects subcollection
      match /projects/{projectId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId);
        allow update: if isOrgMember(orgId) && authorityFieldsUnchanged();
        allow delete: if isOrgOwner(orgId);
        
        // Project history
        match /history/{historyId} {
          allow read: if isOrgMember(orgId);
          allow write: if isOrgMember(orgId);
        }
      }

    }

    match /entryCommands/{commandId} {
      allow read: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        resource.data.scope == 'user';
      allow create: if isAuthenticated() &&
        isValidEntryCommand(request.resource.data, request.auth.uid, 'user');
      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        isValidEntryCommand(request.resource.data, request.auth.uid, 'user');
      allow delete: if false;
    }

    match /teamEntryCommands/{commandId} {
      allow read: if isAuthenticated() &&
        resource.data.scope == 'team' &&
        resource.data.orgId is string &&
        isOrgMember(resource.data.orgId);
      allow create: if isAuthenticated() &&
        request.resource.data.orgId is string &&
        isOrgMember(request.resource.data.orgId) &&
        isValidEntryCommand(request.resource.data, request.auth.uid, 'team');
      allow update: if isAuthenticated() &&
        resource.data.scope == 'team' &&
        resource.data.orgId is string &&
        isOrgMember(resource.data.orgId) &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        isValidEntryCommand(request.resource.data, resource.data.ownerId, 'team');
      allow delete: if isAuthenticated() &&
        resource.data.orgId is string &&
        isOrgOwner(resource.data.orgId);
    }

    // =========================================================================
    // SOCIAL LAYER - Follows, Activity, Posts
    // =========================================================================
    
    // Follow relationships
    match /social_follows/{followId} {
      // Anyone can read follow relationships (public social graph)
      allow read: if isAuthenticated() || isGuest();
      
      // Users can create follows where they are the follower
      allow create: if isVerifiedUser() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followerId != request.resource.data.followingId && // Can't follow self
        isValidString(request.resource.data.followingId, 1, 128);
      
      // Users can only delete their own follows (unfollow)
      allow delete: if isVerifiedUser() &&
        resource.data.followerId == request.auth.uid;
      
      // No updates allowed - delete and recreate
      allow update: if false;
    }
    
    // Activity feed items
    match /social_activity/{activityId} {
      // Anyone authenticated can read activity (for feeds)
      allow read: if isAuthenticated() || isGuest();
      
      // Users can create activity for themselves
      allow create: if isVerifiedUser() &&
        request.resource.data.get('userId', null) == request.auth.uid &&
        request.resource.data.type in ['follow', 'post', 'release', 'achievement', 'collaboration', 'product_drop'] &&
        request.resource.data.timestamp == request.time;
      
      // Users can delete their own activity
      allow delete: if isVerifiedUser() &&
        resource.data.get('userId', null) == request.auth.uid;
      
      // No updates - activity is immutable
      allow update: if false;
    }
    
    // User social stats (follower/following counts)
    match /social_stats/{userId} {
      // Public read for profile display
      allow read: if isAuthenticated() || isGuest();
      
      // Initial stats can be created by the user
      allow create: if isOwner(userId);
      
      // Counters are READ-ONLY for clients (Item 205 fix)
      // Must be updated via Cloud Functions trigger or internal batch
      allow update: if false;
    }

    // =========================================================================
    // COMMERCE ENGINE - Products, Transactions, Carts
    // =========================================================================
    
    // Products / Marketplace listings
    match /products/{productId} {
      // Anyone authenticated can browse products
      allow read: if isAuthenticated() || isGuest();

      // Sellers can create products. Price is stored as an integer in cents
      // (minor currency unit) end-to-end — ISSUE-977 fix contract.
      allow create: if isVerifiedUser() &&
        ownerCreateIsValid('sellerId') &&
        request.resource.data.type in ['song', 'album', 'merch', 'ticket', 'digital-asset', 'service', 'stem-pack'] &&
        request.resource.data.isActive is bool &&
        request.resource.data.price is int &&
        request.resource.data.price >= 0 &&
        isValidString(request.resource.data.title, 1, 200);

      // Sellers can update their own products
      allow update: if isVerifiedUser() && ownerUpdateIsValid('sellerId');

      // Sellers can delete their own products (soft delete preferred)
      allow delete: if isVerifiedUser() &&
        resource.data.sellerId == request.auth.uid;
    }

    // Marketplace purchase records. Writes happen server-side only, from the
    // Stripe webhook (Admin SDK, bypasses these rules) after payment is
    // verified — ISSUE-978 fix contract. Clients may only read their own.
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() &&
        (resource.data.buyerId == request.auth.uid ||
         resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Private stem-pack manifests (storage paths for each stem file) — ISSUE-975
    // fix. The seller may write this once at listing time, but NOBODY may read
    // it back via the client SDK: only the getStemDownloadUrl Cloud Function
    // (Admin SDK) resolves storage paths, after verifying a completed purchase
    // or seller identity, and hands back a short-lived signed URL. This keeps
    // storage paths and any future private fields out of the public product doc.
    match /marketplace_stem_manifests/{productId} {
      allow create: if isVerifiedUser() && request.resource.data.sellerId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Transactions / Purchase records
    match /transactions/{transactionId} {
      // Users can read their own transactions (as buyer or seller)
      allow read: if (isAuthenticated() &&
        (resource.data.buyerId == request.auth.uid || 
         resource.data.sellerId == request.auth.uid)) ||
         (isGuest() && (resource.data.buyerId == 'founder-demo-uid' || resource.data.sellerId == 'founder-demo-uid'));
      
      // Buyers can create transactions (initiate purchase)
      allow create: if isVerifiedUser() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount >= 0 &&
        request.resource.data.createdAt == request.time;
      
      // Status updates should go through Cloud Functions for payment verification
      // Allow limited updates for status progression
      allow update: if isVerifiedUser() &&
        (resource.data.buyerId == request.auth.uid || 
         resource.data.sellerId == request.auth.uid) &&
        // Only status can change, and only to valid next states
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        (
          // Buyer can cancel pending
          (resource.data.buyerId == request.auth.uid && 
           resource.data.status == 'pending' && 
           request.resource.data.status == 'cancelled') ||
          // Seller can mark as shipped (for physical goods)
          (resource.data.sellerId == request.auth.uid && 
           resource.data.status == 'completed' && 
           request.resource.data.status == 'shipped')
        );
      
      // No deletes - transactions are permanent records
      allow delete: if false;
    }
    
    // Shopping carts
    match /carts/{userId} {
      // Users can only access their own cart
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
      
      // Cart items subcollection
      match /items/{itemId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }
    
    // Seller stats/profiles
    match /seller_stats/{userId} {
      // Public read for marketplace display
      allow read: if isAuthenticated() || isGuest();
      
      // Only the seller can initialize
      allow create: if isOwner(userId);
      
      // Stats should be updated via Cloud Functions after transactions
      // Allow limited self-updates for profile info
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['storeName', 'storeDescription', 'updatedAt']);
    }

    // =========================================================================
    // Previously-unruled collections (fell through to the final catch-all deny,
    // silently breaking every feature below with permission-denied). Audited
    // 2026-07-12 against actual renderer usage — see ISSUE-842/944/998/1000/1001
    // and the systemic sweep in that session's ledger entry. Standard owner-by-
    // `userId`-field pattern, matching the convention already used above.
    // =========================================================================

    match /composition_drafts/{draftId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    match /designs/{designId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    // ISSUE-1147: one persisted video-editor project doc per app project ID.
    // ISSUE-1197: LEGACY, READ-ONLY. This top-level collection let any signed-in
    // user create any project id, and a squatted id denied the real owner both
    // read and write — which routed straight into the ISSUE-1193 blank-timeline
    // data-loss path. Documents are now namespaced under their owner (see
    // users/{userId}/videoProjects below). Existing docs stay readable so they
    // can be migrated on first save; nothing writes here again.
    match /videoProjects/{projectId} {
      allow read: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }

    // ISSUE-1175: long-recording upload and processing state is created and
    // advanced only by trusted callables/workers. Owners may observe progress,
    // but no client can forge completion, replace immutable media identity, or
    // delete the audit trail.
    match /videoSessions/{sessionId} {
      allow read: if isAuthenticated() &&
        resource.data.ownerUid is string &&
        resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Resumable GCS session URIs are bearer capabilities. They are returned
    // only by the authenticated callable and must never be readable through
    // Firestore, even by the session owner.
    match /videoSessionUploadGrants/{sessionId} {
      allow read, write: if false;
    }

    // Server-owned dependency receipts gate retention/deletion. Allowing a
    // client to add or remove one would permit either indefinite storage abuse
    // or deletion of media still referenced by an edit/alignment operation.
    match /videoSessionDependencies/{sessionId}/{document=**} {
      allow read, write: if false;
    }

    match /earnings_reports/{reportId} {
      allow read: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if false;
    }

    // EPK portals are meant to be shared with press/media outside the app —
    // public read by design, owner-only write.
    match /epk_portals/{portalId} {
      allow read: if true;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
    }

    match /influencerBounties/{bountyId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    // Global, non-sensitive aggregate operational stats (doc ID = instrumentId).
    // Clients may observe aggregates, but only the recordInstrumentUsage Admin
    // SDK callable may mutate counters.
    match /instrument_usage_stats/{instrumentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Server-only replay/rate-limit records used by recordInstrumentUsage.
    match /instrument_usage_events/{eventId} {
      allow read, write: if false;
    }
    match /instrument_usage_rate_limits/{rateId} {
      allow read, write: if false;
    }

    match /iswc_works/{workId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    // Client-writable financial ledger records (SmartContractService), separate
    // from the `users/{uid}/ledger` server-only subcollection written by webhooks.
    match /ledger/{entryId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    // Merchandise design/product catalog templates: public read, admin-only write
    // (client never creates catalog entries — a denied write here is correct).
    match /merchandise_catalog/{catalogId} {
      allow read: if isAuthenticated() || isGuest();
      allow write: if isAdmin();
    }

    // User-created merch product/design instances (distinct from the catalog
    // templates above) — MerchandiseService.addProduct/deleteProduct.
    match /merchandise/{productId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    match /merchandise_inventory/{itemId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    match /mockup_generations/{mockupId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    // Org invites: visible/creatable by members of the referenced org.
    match /organization_invites/{inviteId} {
      allow read: if isAuthenticated() && isOrgMember(resource.data.orgId);
      allow create: if isAuthenticated() && isOrgMember(request.resource.data.orgId);
      allow update: if orgUpdateIsValid();
      allow delete: if isAuthenticated() && isOrgMember(resource.data.orgId);
    }

    match /print_jobs/{jobId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    match /promoter_pitches/{pitchId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    match /recoupment_balances/{balanceId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create, update, delete: if false;
    }

    match /recoupment_adjustments/{adjustmentId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create, update, delete: if false;
    }

    match /royalty_report_claims/{claimId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create, update, delete: if false;
    }

    match /scheduledPosts/{postId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    match /smart_contracts/{contractId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    // Doc ID is the user's own uid — no separate userId field needed.
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /vinyl_campaigns/{campaignId} {
      allow read, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    // Read-only connectivity probe (HealthPanel) — no client writes expected.
    match /_health_check/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Per-user Vertex context-cache metadata. The registerAiContextCache Admin
    // SDK callable owns writes and stores documents as `{uid}_{contentHash}`.
    // Owner-only reads prevent one user from discovering or using another
    // user's Vertex cached-content resource reference.
    match /ai_context_cache/{hash} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // Generated Content / History
    // =========================================================================
    match /history/{historyId} {
      // Users can read their own history or org history
      allow read: if (isAuthenticated() &&
        (('userId' in resource.data && resource.data.get('userId', null) == request.auth.uid) ||
         (('orgId' in resource.data) && resource.data.orgId != null && isOrgMember(resource.data.orgId)))) || (isGuest() && ('userId' in resource.data && resource.data.get('userId', null) == 'founder-demo-uid'));
      
      // Users can create history entries
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      
      // Users can update their own history
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      
      // Users can delete their own history
      allow delete: if (isVerifiedUser() &&
        ('userId' in resource.data && resource.data.get('userId', null) == request.auth.uid)) || (isGuest() && ('userId' in resource.data && resource.data.get('userId', null) == 'founder-demo-uid'));
    }

    match /design_versions/{versionId} {
      allow read: if (isAuthenticated() &&
        (resource.data.get('userId', null) == request.auth.uid ||
         (('orgId' in resource.data) && resource.data.orgId != null && isOrgMember(resource.data.orgId)))) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      
      allow delete: if (isVerifiedUser() &&
        resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
    }

    match /creative_jobs/{jobId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      // Writes are strictly server-side only via Cloud Functions
      allow write: if false;
    }

    match /creative_sessions/{sessionId} {
      allow read: if (isAuthenticated() &&
        (resource.data.get('userId', null) == request.auth.uid ||
         (('orgId' in resource.data) && resource.data.orgId != null && isOrgMember(resource.data.orgId)))) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');

      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');

      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');

      allow delete: if (isVerifiedUser() &&
        resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
    }

    // Check if the caller is signed in anonymously.
    //
    // This was `isAuthenticated() && provider == 'anonymous'`, which can never be
    // true: `isAuthenticated()` already requires `provider != 'anonymous'`, so the
    // two clauses contradict. It was not exploitable — `isVerifiedUser()` collapsed
    // to `isAuthenticated()`, which already excludes anonymous, so the posture was
    // the intended one — but it is a trap. A future rule written `if isAnonymous()`
    // would silently never grant, and one written `if !isAnonymous()` would silently
    // always grant. Corrected to test the token directly. Behaviour-preserving:
    // verified against the full emulator rules suite.
    function isAnonymous() {
      return request.auth != null &&
             request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Check if user is a verified (non-anonymous) authenticated user.
    function isVerifiedUser() {
      return isAuthenticated() && !isAnonymous();
    }

    // =========================================================================
    // Knowledge Base / RAG Documents
    // =========================================================================
    match /knowledge/{docId} {
      allow read: if (isAuthenticated() &&
        (resource.data.get('userId', null) == request.auth.uid ||
         (('orgId' in resource.data) && resource.data.orgId != null && isOrgMember(resource.data.orgId)))) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      
      allow create: if (isVerifiedUser() &&
        ownerCreateIsValid('userId'));
      
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if isVerifiedUser() &&
        resource.data.get('userId', null) == request.auth.uid;
    }

    // =========================================================================
    // Publishing Registrations (verified users only — PRO/MLC filings)
    // =========================================================================
    match /publishing_registrations/{registrationId} {
      allow read: if (isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if false;
    }

    // Registration Center stores per-user, per-track org status under:
    // /registrations/{userId}/tracks/{trackId}/orgs/{orgId}
    match /registrations/{userId}/tracks/{trackId}/orgs/{orgId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    // =========================================================================
    // Split Escrows (verified users only — financial holds)
    // =========================================================================
    match /split_escrows/{escrowId} {
      allow read: if (isVerifiedUser() && (
        resource.data.initiatorUid == request.auth.uid ||
        request.auth.uid in resource.data.parties
      ));
      // initiateSplitEscrow, signEscrow, and releaseEscrow are authenticated
      // server callables with explicit state transitions. The Admin SDK bypasses
      // these rules; clients cannot manufacture or mutate financial state.
      allow create, update, delete: if false;
    }

    // =========================================================================
    // Audit Logs (read-only — written by Cloud Functions only)
    // System Audit logs: Only readable by Admins
    match /audit_logs/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid);
      allow create, update, delete: if false;
    }

    // =========================================================================
    // Push Notification Tokens (user-scoped)
    // =========================================================================
    match /notification_tokens/{tokenId} {
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    // =========================================================================
    // Memory Architecture — 5-Layer System (user-scoped subcollections)
    // =========================================================================

    // Layer 3: CORE Vault — Authoritative fact store (supersede-never-delete)
    match /users/{userId}/vault/{category} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      // Facts are superseded, never deleted — enforced at app layer
      allow delete: if false;
    }

    // Layer 4: Captain's Logs — Daily append-only operational timeline
    match /users/{userId}/captains_logs/{dateKey} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      // Entries can only be appended (arrayUnion), never removed
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Owner-scoped user subcollections previously missing rules entirely
    // (ISSUE-842 for integrations; LivingFileService/StyleMemoryStore had none).
    match /users/{userId}/living_files/{fileName} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/styleLedger/{entryId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/styleDNA/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Evolas fader values (docs/EVOLAS_BUILD_PLAN.md, non-negotiable #1):
    // this document may only ever contain style-rendering knobs. It has no
    // field capable of carrying a substance/verdict override, by schema.
    match /users/{userId}/personaFaders/{personaId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.personaId is string
        && request.resource.data.personaId == personaId
        && request.resource.data.updatedAt is number
        && request.resource.data.values is map
        && request.resource.data.values.keys().hasOnly([
             'riskTolerance', 'brevity', 'directness', 'formality', 'reasoningTransparency'
           ])
        && request.resource.data.values.riskTolerance is int
        && request.resource.data.values.riskTolerance >= 0 && request.resource.data.values.riskTolerance <= 100
        && request.resource.data.values.brevity is int
        && request.resource.data.values.brevity >= 0 && request.resource.data.values.brevity <= 100
        && request.resource.data.values.directness is int
        && request.resource.data.values.directness >= 0 && request.resource.data.values.directness <= 100
        && request.resource.data.values.formality is int
        && request.resource.data.values.formality >= 0 && request.resource.data.values.formality <= 100
        && request.resource.data.values.reasoningTransparency is int
        && request.resource.data.values.reasoningTransparency >= 0 && request.resource.data.values.reasoningTransparency <= 100;
      allow delete: if isOwner(userId);
    }

    // Evolas implicit interaction signals (docs/EVOLAS_BUILD_PLAN.md T1.6):
    // observational events only (copied/acted-on/re-asked/switched/abandoned).
    // Immutable — each signal is a point-in-time record of what the user did,
    // never edited after the fact, never deleted (permanent telemetry record,
    // same posture as visualVerifications above).
    match /users/{userId}/personaInteractionSignals/{signalId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.personaId is string
        && request.resource.data.personaId.size() > 0
        && request.resource.data.responseId is string
        && request.resource.data.responseId.size() > 0
        && request.resource.data.signalType in [
             'copied', 'actedOn', 'reAsked', 'personaSwitched', 'threadAbandoned'
           ]
        && request.resource.data.occurredAt is number;
      allow update, delete: if false;
    }

    // Server-generated MCP evidence receipts. The authenticated owner may read
    // the byte-level audit result, but cannot forge, alter, or erase evidence.
    match /users/{userId}/assetAuditReceipts/{auditId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // PODCredentialService — POD provider API keys, field-level per provider.
    match /users/{userId}/integrations/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Tax Form Collection (ISSUE-1118) — W-9/W-8BEN collaborator records.
    // Owner-scoped; artist may delete anytime (retention is the taxpayer's
    // duty, not ours). Actual file bytes live in Storage at
    // tax_docs/{userId}/{collaboratorId}/{fileName}; this doc tracks status
    // and metadata only.
    match /users/{userId}/tax_collaborators/{collaboratorId} {
      allow read, write: if isOwner(userId);
    }

    // ISSUE-1197: video-editor timelines, namespaced under their owner so one
    // user's project-id space cannot collide with another's. This replaces the
    // top-level /videoProjects collection, where any signed-in user could create
    // any project id and thereby lock the real owner out of both read and write.
    // Namespacing removes the collision entirely, so id entropy stops being
    // load-bearing.
    //
    // Ownership is immutable: `userId` is pinned on update, matching the standard
    // applied to the licences rules. Without this an update could rewrite the
    // document's owner.
    match /users/{userId}/videoProjects/{projectId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && clientIdentityFieldsMatchCaller();
      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && authorityFieldsUnchanged();
    }

    // Single-use collaborator upload tokens (ISSUE-1118 Phase 2). The
    // collaborator has no indii account, so the token itself — validated
    // and consumed only by the submitTaxForm Cloud Function via the Admin
    // SDK — is the entire auth boundary. No client, including the artist,
    // may read or write these directly.
    match /taxFormRequests/{token} {
      allow read, write: if false;
    }

    // =========================================================================
    // Licensing Clearances (ISSUE-827: Sync clearance workflow)
    // =========================================================================
    match /licensing_clearances/{clearanceId} {
      allow read: if (isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update, delete: if false;
    }

    // =========================================================================
    // Clearance Docs (ISSUE-827) — SyncLicensingClearanceService
    // Client may create requirements and mark its own doc uploaded; approval /
    // rejection is reviewer-only (deferred: admin surface / Cloud Function).
    // =========================================================================
    match /clearance_docs/{clearanceId} {
      allow read: if (isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid)
                  || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser()
                    && ownerCreateIsValid('userId')
                    && request.resource.data.get('status', '') == 'pending_upload';
      allow update: if isVerifiedUser()
                    && ownerUpdateIsValid('userId')
                    && request.resource.data.get('status', '') in ['pending_upload', 'uploaded'];
      allow delete: if false;
    }

    // =========================================================================
    // Label Deals
    // =========================================================================
    match /label_deals/{dealId} {
      allow read: if (isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if false;

      // Recoupment transactions applied against this deal — owner of the parent deal only.
      match /transactions/{txId} {
        allow read, create: if isVerifiedUser() &&
          get(/databases/$(database)/documents/label_deals/$(dealId)).data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // Deletion Requests
    // =========================================================================
    match /_deletion_requests/{userId} {
      allow read: if isVerifiedUser() && request.auth.uid == userId;
      allow create: if isVerifiedUser() && request.auth.uid == userId;
      allow update, delete: if false;
    }

    // =========================================================================
    // Core Domain Collections (Distribution, Legal, Finance, Marketing, etc.)
    // =========================================================================

    match /ddexReleases/{releaseId} {
      allow read: if (isAuthenticated() && (resource.data.get('userId', null) == request.auth.uid || (('orgId' in resource.data) && resource.data.orgId != null && isOrgMember(resource.data.orgId)))) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerOrOrgCreateIsValid();
      allow update: if isVerifiedUser() && ownerOrOrgUpdateIsValid();
      allow delete: if (isVerifiedUser() && (resource.data.get('userId', null) == request.auth.uid || (('orgId' in resource.data) && resource.data.orgId != null && isOrgMember(resource.data.orgId)))) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
    }
    match /proprietaryIngestionReleases/{releaseId} {
      allow read: if (isAuthenticated() && (resource.data.get('userId', null) == request.auth.uid || (('orgId' in resource.data) && (resource.data.orgId == request.auth.uid || (resource.data.orgId != null && isOrgMember(resource.data.orgId)))))) || (isGuest() && (resource.data.get('userId', null) == 'founder-demo-uid' || (('orgId' in resource.data) && resource.data.orgId == 'founder-demo-uid')));
      allow create: if isVerifiedUser() && ownerOrOrgCreateIsValid();
      allow update: if isVerifiedUser() && ownerOrOrgUpdateIsValid();
      allow delete: if false;
    }
    // Root-level projects (user-owned, with org-member fallback).
    // NOTE: This is distinct from /organizations/{orgId}/projects/{projectId}
    // which is the org-scoped subcollection. Both paths are intentional.
    match /projects/{projectId} {
      allow read: if (isAuthenticated() && (resource.data.get('userId', null) == request.auth.uid || (('orgId' in resource.data) && resource.data.orgId != null && isOrgMember(resource.data.orgId)))) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerOrOrgCreateIsValid();
      allow update: if isVerifiedUser() && ownerOrOrgUpdateIsValid();
      allow delete: if (isVerifiedUser() && (resource.data.get('userId', null) == request.auth.uid || (('orgId' in resource.data) && resource.data.orgId != null && isOrgMember(resource.data.orgId)))) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');

      match /releaseHarnessRuns/{runId} {
        allow read, write: if exists(/databases/$(database)/documents/projects/$(projectId)) &&
          (
            (isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid) ||
            (
              isAuthenticated() &&
              ('orgId' in get(/databases/$(database)/documents/projects/$(projectId)).data) &&
              get(/databases/$(database)/documents/projects/$(projectId)).data.orgId != null &&
              isOrgMember(get(/databases/$(database)/documents/projects/$(projectId)).data.orgId)
            ) ||
            get(/databases/$(database)/documents/projects/$(projectId)).data.userId == 'founder-demo-uid'
          );
      }

      match /harnessRuns/{runId} {
        allow read, create, update: if exists(/databases/$(database)/documents/projects/$(projectId)) &&
          (
            (isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid) ||
            (
              isAuthenticated() &&
              ('orgId' in get(/databases/$(database)/documents/projects/$(projectId)).data) &&
              get(/databases/$(database)/documents/projects/$(projectId)).data.orgId != null &&
              isOrgMember(get(/databases/$(database)/documents/projects/$(projectId)).data.orgId)
            ) ||
            get(/databases/$(database)/documents/projects/$(projectId)).data.userId == 'founder-demo-uid'
          );
        allow delete: if false;
      }
    }
    match /proactive_tasks/{taskId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if (isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
    }
    match /videoJobs/{jobId} {
      allow read: if (isAuthenticated() && (resource.data.get('userId', null) == request.auth.uid || (('orgId' in resource.data) && resource.data.orgId != null && isOrgMember(resource.data.orgId)))) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      // Every generation job is created and advanced by trusted backend code.
      // A client-created `queued` document would invoke the Firestore worker
      // without App Check, entitlement, Arcjet, or cost-reservation admission.
      allow create, update, delete: if false;
    }
    match /distribution_audit/{releaseId}/{allPaths=**} {
      allow read: if canReadDistributionRelease(releaseId);
      allow create: if false;
      allow update, delete: if false; // immutable audit logs
    }
    match /distribution_tasks/{taskId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if (isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
    }
    match /distribution_takedowns/{releaseId}/{allPaths=**} {
      allow read: if canReadDistributionRelease(releaseId);
      allow create, update, delete: if false;
    }
    match /isrc_pool/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }
    // Identifier registries (ISSUE-888): owner-only reads, backend-only writes.
    // All creates go through recordDistributionIdentifier /
    // assignDistributionIdentifier callables (Admin SDK bypasses rules), which
    // enforce release ownership, format, and uniqueness (ISSUE-887).
    match /isrc_registry/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /upc_pool/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }
    match /upc_registry/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /campaigns/{campaignId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if (isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
    }
    match /publicist_campaigns/{campaignId} {
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow update: if ownerUpdateIsValid('userId');
    }
    match /publicist_contacts/{contactId} {
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow update: if ownerUpdateIsValid('userId');
    }
    match /founderFunnelEvents/{eventId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'eventName',
          'path',
          'url',
          'sessionId',
          'source',
          'userId',
          'email',
          'detailsJson',
          'occurredAtMs',
          'createdAt'
        ]) &&
        request.resource.data.eventName in [
          'founder_site_view',
          'founder_preview_cta_clicked',
          'founder_auth_viewed',
          'founder_auth_submitted',
          'founder_auth_completed',
          'founder_walkthrough_started',
          'founder_walkthrough_completed',
          'founder_intro_panels_closed',
          'founder_portal_viewed',
          'founder_checkout_viewed',
          'founder_boardroom_reached',
          'founder_agreement_reviewed',
          'founder_path_selected',
          'founder_pay_now_selected',
          'founder_talk_first_selected',
          'founder_interest_clicked'
        ] &&
        request.resource.data.source == 'founder' &&
        request.resource.data.path is string &&
        request.resource.data.path.size() > 0 &&
        request.resource.data.path.size() <= 200 &&
        request.resource.data.url is string &&
        request.resource.data.url.size() > 0 &&
        request.resource.data.url.size() <= 500 &&
        request.resource.data.sessionId is string &&
        request.resource.data.sessionId.size() >= 8 &&
        request.resource.data.sessionId.size() <= 80 &&
        request.resource.data.detailsJson is string &&
        request.resource.data.detailsJson.size() <= 2000 &&
        request.resource.data.occurredAtMs is number &&
        request.resource.data.createdAt is timestamp &&
        (!('userId' in request.resource.data) || request.resource.data.userId == null || request.resource.data.userId is string) &&
        (!('email' in request.resource.data) || request.resource.data.email == null || request.resource.data.email is string);
      allow read, update, delete: if false;
    }
    match /projects/{projectId}/livingPlans/{planId} {
      allow read, write: if exists(/databases/$(database)/documents/projects/$(projectId)) &&
        (
          (isAuthenticated() && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid) ||
          (
            isAuthenticated() &&
            ('orgId' in get(/databases/$(database)/documents/projects/$(projectId)).data) &&
            get(/databases/$(database)/documents/projects/$(projectId)).data.orgId != null &&
            isOrgMember(get(/databases/$(database)/documents/projects/$(projectId)).data.orgId)
          ) ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == 'founder-demo-uid'
        );
    }
    match /workflows/{flowId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid;
    }
    match /bountyLinks/{bountyId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if (isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
    }
    match /scheduled_posts/{postId} {
      allow read, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('authorId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('authorId');
    }
    match /posts/{postId} {
      allow read: if isAuthenticated() || isGuest();
      allow create: if isVerifiedUser() && ownerCreateIsValid('authorId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('authorId');
      allow delete: if isVerifiedUser() && resource.data.authorId == request.auth.uid;
    }
    match /legal_audit_ledger/{auditId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update, delete: if false;
    }
    match /legal_templates/{templateId}/{allPaths=**} {
      allow read: if isAuthenticated() || isGuest();
      allow write: if isAdmin();
    }
    match /expenses/{expenseId} {
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }
    match /earnings/{earningId} {
      allow read: if (isAuthenticated() && (resource.data.get('userId', null) == request.auth.uid || resource.data.labelId == request.auth.uid)) || (isGuest() && (resource.data.get('userId', null) == 'founder-demo-uid' || resource.data.labelId == 'founder-demo-uid'));
      allow write: if false;
    }
    match /revenue/{revenueId} {
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }
    match /manufacture_requests/{requestId} {
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }
    match /payouts/{payoutId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow write: if false;
    }
    match /master_verifications/{verificationId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create, update, delete: if false;
    }
    // Server-owned canonical-master analysis receipt. Required identity fields:
    // userId, contentHash, generation, storageBucket, storagePath, status.
    // The Admin SDK worker owns all writes; an artist can read only their receipt.
    match /audio_analysis_receipts/{receiptId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /timelines/{userId}/items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    // =========================================================================
    // Agent Orchestration (Traces & Tasks)
    // =========================================================================
    match /agent_traces/{traceId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if false;
    }
    match /agent_tasks/{traceId}/{allPaths=**} {
      allow read: if (isAuthenticated() && get(/databases/$(database)/documents/agent_traces/$(traceId)).data.userId == request.auth.uid) || (isGuest() && get(/databases/$(database)/documents/agent_traces/$(traceId)).data.userId == 'founder-demo-uid');
      allow create: if (isVerifiedUser() && get(/databases/$(database)/documents/agent_traces/$(traceId)).data.userId == request.auth.uid) || (isGuest() && get(/databases/$(database)/documents/agent_traces/$(traceId)).data.userId == 'founder-demo-uid');
      allow update, delete: if (isVerifiedUser() && get(/databases/$(database)/documents/agent_traces/$(traceId)).data.userId == request.auth.uid) || (isGuest() && get(/databases/$(database)/documents/agent_traces/$(traceId)).data.userId == 'founder-demo-uid');
    }

    // =========================================================================
    // Boardroom & Session Synced Messages
    // =========================================================================
    match /sessions/{sessionId} {
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }
    match /sessions/{sessionId}/messages/{messageId} {
      allow read, update, delete: if (isAuthenticated() && get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('userId', null) == request.auth.uid) || (isGuest() && get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('userId', null) == 'founder-demo-uid');
      allow create: if (isVerifiedUser() && get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('userId', null) == request.auth.uid) || (isGuest() && get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('userId', null) == 'founder-demo-uid');
    }
    match /boardroom_messages/{msgId} {
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }
    // Manager-to-manager information notes. Tasks are deliberately not stored
    // here: manager routing is enforced in the renderer communication policy.
    match /agent_notes/{noteId} {
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    // =========================================================================
    // Cost Control & Billing Ledgers
    // =========================================================================
    match /costLedger/{ledgerId} {
      // Root records are individual reservations. Aggregate documents live in
      // users/{uid}/costLedger so a creator cannot read another creator's spend.
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      // Server-owned ledger. Reservations are written by enforceOperationCost.
      allow create, update: if false;
      allow delete: if false;
    }

    match /incidents/{incidentId} {
      // Server-owned safety incidents. Written by cost-control functions.
      allow create: if false;
      allow read, update, delete: if false;
    }

    // =========================================================================
    // Token Usage & Rate Limits
    // =========================================================================
    match /user_usage_stats/{statId} {
      allow read: if (isAuthenticated() && statId.matches(request.auth.uid + '_[0-9-]+')) || (isGuest() && statId.matches('founder-demo-uid_[0-9-]+'));
      allow create, update: if (isVerifiedUser() && statId.matches(request.auth.uid + '_[0-9-]+')) || (isGuest() && statId.matches('founder-demo-uid_[0-9-]+'));
      allow delete: if false;
    }

    match /user_rate_limits/{limitId} {
      allow read: if (isAuthenticated() && limitId.matches(request.auth.uid + '_[0-9]+')) || (isGuest() && limitId.matches('founder-demo-uid_[0-9]+'));
      allow create, update: if (isVerifiedUser() && limitId.matches(request.auth.uid + '_[0-9]+')) || (isGuest() && limitId.matches('founder-demo-uid_[0-9]+'));
      allow delete: if false;
    }

    // =========================================================================
    // Touring Manager (Vehicles & Itineraries)
    // =========================================================================
    match /tour_vehicles/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid;
    }

    match /tour_itineraries/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid;
    }

    match /tour_rider_items/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid;
    }

    match /tour_emergency_contacts/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid;
    }

    // =========================================================================
    // Latent-403 fixes (2026-05-28) — see docs/architecture/FIRESTORE_RULES_403_AUDIT.md
    // =========================================================================

    // Owner-by-field (userId): a user's own top-level records (queries filter on userId).
    match /career_memory_archive/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid;
    }
    match /knowledge_history/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
    }
    match /google_search_history/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
    }
    match /sample_requests/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
    }
    match /sftp_ingestions/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update, delete: if false;
    }
    match /video_releases/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    // Owner-by-field (requestedBy).
    match /takedown_requests/{docId} {
      allow read: if isAuthenticated() && resource.data.requestedBy == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('requestedBy');
      allow update, delete: if false;
    }

    match /licenses/{licenseId} {
      allow read: if isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid;
    }

    // Owner-by-path segment (uid).
    match /mechanical_licenses/{uid}/licenses/{licenseId} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Public-read / owner-write (ownerId): marketplace drops are publicly shareable but require auth.
    match /marketplace_drops/{dropId} {
      allow read: if isAuthenticated();
      allow create: if isVerifiedUser() && ownerCreateIsValid('ownerId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('ownerId');
      allow delete: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
    }

    // Global read-only reference data (writes only via server/Admin SDK).
    match /content_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /sample_platforms/{platformId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // SECURITY: clients should NOT write fraud alerts directly.
    // Fixed: FraudDetectionService.persistAlert moved to a Cloud Function (Admin SDK).
    match /fraud_alerts/{alertId} {
      allow create, read, update, delete: if false;
    }

    // =========================================================================
    // Missing Root Collections (For Services extending FirestoreService)
    // =========================================================================
    match /file_nodes/{docId} {
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }
    match /audio_assets/{docId} {
      function isOwnedAudioAsset(data, ownerId) {
        return data.keys().hasOnly([
          'id', 'userId', 'type', 'prompt', 'mimeType', 'estimatedDuration', 'generatedAt',
          'storageUrl', 'dataUri', 'bpm', 'key', 'energy', 'loudness', 'genre', 'mood',
          'tempo', 'voicePreset', 'fullText'
        ]) &&
        data.get('id', null) == docId &&
        data.get('userId', null) == ownerId &&
        data.get('type', null) in ['soundfx', 'music', 'tts'] &&
        isValidString(data.get('prompt', null), 1, 10000) &&
        isValidString(data.get('mimeType', null), 6, 128) &&
        data.get('estimatedDuration', null) is number &&
        data.get('estimatedDuration', null) > 0 && data.get('estimatedDuration', null) <= 7200 &&
        isValidString(data.get('generatedAt', null), 20, 64) &&
        (
          (data.get('storageUrl', null) is string && data.get('storageUrl', null).size() > 0) ||
          (data.get('dataUri', null) is string && data.get('dataUri', null).size() > 0 && data.get('dataUri', null).size() <= 1048576)
        );
      }
      allow read, delete: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create: if ((isVerifiedUser() && isOwnedAudioAsset(request.resource.data, request.auth.uid)) || (isGuest() && isOwnedAudioAsset(request.resource.data, 'founder-demo-uid')));
      allow update: if ((isVerifiedUser() && resource.data.get('userId', null) == request.auth.uid && isOwnedAudioAsset(request.resource.data, request.auth.uid)) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid' && isOwnedAudioAsset(request.resource.data, 'founder-demo-uid')));
    }
    match /deployments/{docId} {
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }
    match /tax_profiles/{docId} {
      allow read: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
      allow delete: if false;
    }
    match /dsr_processed_reports/{docId} {
      allow read: if (isAuthenticated() && resource.data.get('userId', null) == request.auth.uid) || (isGuest() && resource.data.get('userId', null) == 'founder-demo-uid');
      allow create, update, delete: if false;
    }
    match /tracks/{docId} {
      allow read, delete: if isAuthenticated() && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isVerifiedUser() && ownerCreateIsValid('userId');
      allow update: if isVerifiedUser() && ownerUpdateIsValid('userId');
    }

    // =========================================================================
    // MCP/A2A Job Queues (Server-side writes only, via Admin SDK)
    // =========================================================================
    match /payoutJobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.get('initiatorUid', null) == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /payoutBatches/{batchId} {
      allow read: if isAuthenticated() && resource.data.get('initiatorUid', null) == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /mcpRenderJobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.get('initiatorUid', null) == request.auth.uid;
      allow create, update, delete: if false;
    }
    // Note: mcpJobs collection removed (2026-07-20) — audit_sample_clearance is fail-closed,
    // no tool writes to this collection. Durable intent queues (payoutJobs, mcpRenderJobs,
    // campaigns) await processors per ISSUE-1100.

    // =========================================================================
    // Attribution spine — smart links and the conversion event outbox
    // =========================================================================

    // Smart links resolve to a redirect destination. The artist manages their
    // own; the public never reads this collection, because the redirect
    // function resolves slugs with the Admin SDK.
    //
    // artistId is immutable after creation: allowing it to change would let one
    // artist reassign a link — and every conversion attributed through it — to
    // another account.
    match /smartLinks/{slug} {
      allow read: if isAuthenticated() && resource.data.get('artistId', '') == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.get('artistId', '') == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.get('artistId', '') == request.auth.uid
        && request.resource.data.get('artistId', '') == resource.data.get('artistId', '');
      allow delete: if isAuthenticated() && resource.data.get('artistId', '') == request.auth.uid;
    }

    // Conversion events are the evidence the optimizer spends money on. A
    // client that could write here could manufacture conversions and steer an
    // artist's budget; a client that could read here would see every other
    // artist's fan activity. Server-only, both directions.
    match /conversionEventOutbox/{eventId} {
      allow read, write: if false;
    }

    // =========================================================================
    // Limited Drops (Merchandise / Limited-Time Campaigns)
    // =========================================================================
    // Draft drops created by users. Admin SDK publishes them (status -> 'active').
    // Only owner can read/update; deletion is audit-only (denied).
    match /limitedDrops/{dropId} {
      function isValidLimitedDrop() {
        return request.resource.data.get('userId', '') == request.auth.uid &&
          request.resource.data.get('selectedProductIds', []) is list &&
          request.resource.data.get('selectedProductIds', []).size() >= 1 &&
          request.resource.data.get('dropName', '') is string &&
          request.resource.data.get('dropName', '').size() >= 1 &&
          request.resource.data.get('dropName', '').size() <= 200 &&
          request.resource.data.get('dropDateTime', '') is string &&
          request.resource.data.get('status', '') == 'draft' &&
          request.resource.data.get('countdownMessage', '') is string &&
          request.resource.data.get('countdownMessage', '').size() <= 500;
      }
      allow read: if isAuthenticated() && resource.data.get('userId', '') == request.auth.uid;
      allow create: if isAuthenticated() && isVerifiedUser() && isValidLimitedDrop();
      allow update: if isAuthenticated() &&
        resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'publishedAt', 'notificationSentAt', 'countdownMessage']
        );
      allow delete: if false;
    }

    // =========================================================================
    // Tax Form Submission Requests (Finance/Tokens)
    // =========================================================================
    // Single-use token-based links for collaborators to submit tax forms without auth.
    // Token is 64-char hex. Once consumedAt is set (by backend), reuse is denied.
    match /taxFormRequests/{token} {
      allow read: if request.query.limit <= 1 && token.size() == 64;
      allow create, update, delete: if false; // Callable/Admin SDK only
    }

    // =========================================================================
    // Deny all other access by default
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
