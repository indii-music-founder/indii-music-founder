rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ========================================
    // HELPER FUNCTIONS
    // ========================================

    function isAuthenticated() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && 
        request.auth.uid in firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.members;
    }

    // Guest explorer writes are retired. Keep this helper so legacy rule branches
    // stay syntactically stable, but make every guest path fail closed.
    function isGuest() {
      return false;
    }

    // File size limits (in bytes)
    function isUnderSizeLimit(maxMB) {
      return request.resource.size < maxMB * 1024 * 1024;
    }

    // Content type validation
    function isImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideoType() {
      return request.resource.contentType.matches('video/.*');
    }

    function isAudioType() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isAllowedMediaType() {
      return isImageType() || isVideoType() || isAudioType() ||
             request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/json') ||
             request.resource.contentType.matches('text/.*') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
             request.resource.contentType.matches('application/zip') ||
             request.resource.contentType.matches('application/x-zip-compressed') ||
             request.resource.contentType.matches('font/.*') ||
             request.resource.contentType.matches('application/x-font-.*');
    }

    // ========================================
    // USER-SPECIFIC STORAGE (Private)
    // ========================================

    // Users can only access their own storage
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
      // Create/update: authenticated owner, under 500MB, valid media type.
      allow create, update: if isAuthenticated() &&
                              request.auth.uid == userId &&
                              isUnderSizeLimit(500) &&
                              isAllowedMediaType();
    }

    // Content-addressed source masters: the authenticated owner can create a
    // correctly identified audio object once, but clients can never replace or
    // delete it. Admin retention/backup controls remain server-side.
    match /masters/{userId}/{contentHash}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() &&
                      request.auth.uid == userId &&
                      resource == null &&
                      contentHash.matches('^[a-f0-9]{64}$') &&
                      fileName.matches('^original\\.[A-Za-z0-9]{2,8}$') &&
                      isUnderSizeLimit(500) &&
                      isAudioType() &&
                      request.resource.metadata.keys().hasAll([
                        'contentHash', 'ownerId', 'immutable', 'masterFingerprint', 'originalFileName'
                      ]) &&
                      request.resource.metadata.contentHash == contentHash &&
                      request.resource.metadata.ownerId == request.auth.uid &&
                      request.resource.metadata.immutable == 'true' &&
                      request.resource.metadata.masterFingerprint is string &&
                      request.resource.metadata.masterFingerprint.size() > 0 &&
                      request.resource.metadata.masterFingerprint.size() <= 512 &&
                      request.resource.metadata.originalFileName is string &&
                      request.resource.metadata.originalFileName.size() > 0 &&
                      request.resource.metadata.originalFileName.size() <= 512;
      allow update, delete: if false;
    }

    // Content-addressed release cover art: like masters, the owner may create
    // the exact identified bytes once. Desktop packaging re-measures the
    // downloaded bytes before DDEX delivery; clients cannot replace or remove
    // the provenance object afterward.
    match /covers/{userId}/{contentHash}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() &&
                      request.auth.uid == userId &&
                      resource == null &&
                      contentHash.matches('^[a-f0-9]{64}$') &&
                      fileName.matches('^original\\.(jpe?g|png)$') &&
                      isUnderSizeLimit(50) &&
                      request.resource.contentType in ['image/jpeg', 'image/png'] &&
                      request.resource.metadata.keys().hasAll([
                        'contentHash', 'ownerId', 'immutable', 'originalFileName'
                      ]) &&
                      request.resource.metadata.contentHash == contentHash &&
                      request.resource.metadata.ownerId == request.auth.uid &&
                      request.resource.metadata.immutable == 'true' &&
                      request.resource.metadata.originalFileName is string &&
                      request.resource.metadata.originalFileName.size() > 0 &&
                      request.resource.metadata.originalFileName.size() <= 512;
      allow update, delete: if false;
    }

    // Creative Suite thin client asset uploads
    match /creative/{userId}/{allPaths=**} {
      // Owner can read their own uploaded assets and results
      allow read: if (isAuthenticated() && request.auth.uid == userId) || (isGuest() && userId == 'founder-demo-uid');
      allow delete: if isAuthenticated() && request.auth.uid == userId;
      // Owner can upload reference media; creation/update stays size and MIME gated.
      allow create, update: if ((isAuthenticated() && request.auth.uid == userId) || (isGuest() && userId == 'founder-demo-uid')) &&
                              isUnderSizeLimit(100) && // limit references to 100MB
                              (isImageType() || isVideoType() || isAudioType());
    }

    // ========================================
    // ORGANIZATION-SCOPED STORAGE
    // ========================================

    // Org members can access org storage
    match /orgs/{orgId}/{allPaths=**} {
      allow read: if isOrgMember(orgId);
      // Write: org member, under 500MB, valid media type
      allow write: if isOrgMember(orgId) &&
                      isUnderSizeLimit(500) &&
                      isAllowedMediaType();
    }

    // ========================================
    // PROJECT-SPECIFIC STORAGE
    // ========================================

    // Allow users to upload to their own folder within a project
    match /projects/{projectId}/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid == userId
        && firestore.exists(/databases/(default)/documents/projects/$(projectId))
        && isOrgMember(firestore.get(/databases/(default)/documents/projects/$(projectId)).data.orgId);
      allow write: if isAuthenticated() && request.auth.uid == userId
        && firestore.exists(/databases/(default)/documents/projects/$(projectId))
        && isOrgMember(firestore.get(/databases/(default)/documents/projects/$(projectId)).data.orgId)
        && isUnderSizeLimit(1024)
        && isAllowedMediaType();
    }

    // ========================================
    // VIDEO STORAGE (User-generated content)
    // ========================================

    // User-uploaded and AI-generated videos (client-side uploads from Veo pipeline)
    match /videos/{userId}/{allPaths=**} {
      // Owner can read their own videos
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Owner can upload: authenticated, size ≤ 500MB, valid video type
      allow write: if isAuthenticated() &&
                      request.auth.uid == userId &&
                      isUnderSizeLimit(500) &&
                      isVideoType();
    }

    // Video thumbnails (auto-generated poster frames)
    match /video-thumbnails/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() &&
                      request.auth.uid == userId &&
                      isUnderSizeLimit(10) &&
                      isImageType();
    }

    // ========================================
    // VIDEO GENERATION OUTPUT (System-managed)
    // ========================================

    // Generated videos from Veo - read-only for users
    match /generated/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Writes only allowed from Cloud Functions (no client writes)
      allow write: if false;
    }

    // ========================================
    // PUBLIC ASSETS (CDN)
    // ========================================

    // Public readable assets (e.g., thumbnails, shared media)
    match /public/{allPaths=**} {
      // SECURITY: Only authenticated users can read public assets (prevents scraper exfiltration)
      allow read: if isAuthenticated();
      // SECURITY: Restrict unauthorized writes to public assets
      allow write: if false;
    }

    // ========================================
    // STEM PACKS (verified artist uploads)
    // ========================================

    // Stem pack files uploaded by artists for marketplace
    match /stems/{userId}/{allPaths=**} {
      // The owner can read their own stems; buyers get access via signed URLs from Cloud Functions
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Owner can upload: verified, size ≤ 250MB, audio files only
      allow write: if isAuthenticated() &&
                      request.auth.uid == userId &&
                      isUnderSizeLimit(250) &&
                      isAudioType();
    }

    // ========================================
    // TAX DOCUMENTS (Sensitive PII — W-9/W-8BEN)
    // ========================================

    // Owner-uploaded tax forms for payment collaborators. Retention is the
    // artist's call, not ours (IRS recordkeeping duty falls on the taxpayer,
    // not the software) — artist may delete anytime. No update: a corrected
    // file is a new upload under a new fileName, keeping prior versions
    // addressable until the artist explicitly deletes them.
    match /tax_docs/{userId}/{collaboratorId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() &&
                      request.auth.uid == userId &&
                      isUnderSizeLimit(20) &&
                      request.resource.contentType in ['application/pdf', 'image/png', 'image/jpeg'];
      allow update: if false;
    }

    // ========================================
    // APP RELEASES (Founders)
    // ========================================

    // Releases like DMG and EXE files
    match /founders/releases/{allPaths=**} {
      allow read: if isAuthenticated() && 
                  (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.subscriptionTier == 'founder' ||
                   firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.tier == 'founder' ||
                   firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isFounder == true);
      allow write: if false; // Admin uploads only via Firebase Console or Admin SDK
    }

    // ========================================
    // DENY ALL OTHER ACCESS
    // ========================================

    // Any paths not explicitly matched above are denied by default
  }
}
