{
  "rule": [
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 1,
        "matchesPrefix": [
          "tmp/",
          "temp/",
          "audio-analysis-temp/",
          "creative-tmp/",
          "staging/"
        ]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 7,
        "matchesPrefix": [
          "trash/"
        ]
      }
    },
    {
      "action": {
        "type": "SetStorageClass",
        "storageClass": "NEARLINE"
      },
      "condition": {
        "age": 30,
        "matchesPrefix": [
          "masters/"
        ],
        "matchesStorageClass": [
          "STANDARD"
        ]
      }
    },
    {
      "action": {
        "type": "SetStorageClass",
        "storageClass": "NEARLINE"
      },
      "condition": {
        "age": 90,
        "matchesPrefix": [
          "videos/",
          "generated/"
        ],
        "matchesStorageClass": [
          "STANDARD"
        ]
      }
    },
    {
      "action": {
        "type": "AbortIncompleteMultipartUpload"
      },
      "condition": {
        "age": 1
      }
    }
  ]
}
