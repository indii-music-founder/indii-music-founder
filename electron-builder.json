{
  "appId": "com.indii.music",
  "beforePack": "./scripts/build-bundled-mcp.cjs",
  "afterPack": "./scripts/verify-packed-mcp.cjs",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "**/node_modules/ffmpeg-static/**",
    "**/node_modules/ffprobe-static/**"
  ],
  "extraResources": [
    {
      "from": "dist/bundled-mcp/local",
      "to": "mcp-server-local"
    },
    {
      "from": "dist/bundled-mcp/harness",
      "to": "mcp-server-harness"
    },
    {
      "from": "execution",
      "to": "execution",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "packages/raw-converter/target/release/indii-raw",
      "to": "packages/raw-converter/indii-raw"
    }
  ],
  "linux": {
    "target": [
      "AppImage"
    ]
  },
  "mac": {
    "category": "public.app-category.productivity",
    "identity": null,
    "gatekeeperAssess": false,
    "hardenedRuntime": false,
    "icon": "build/icon.icns",
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      }
    ],
    "notarize": false
  },
  "productName": "indii.music",
  "protocols": [
    {
      "name": "indii.music Auth Protocol",
      "schemes": [
        "indii"
      ]
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "indii-music-founder",
      "repo": "indii-music-founder",
      "releaseType": "release"
    }
  ],
  "win": {
    "artifactName": "${productName} Setup ${version}-${arch}.${ext}",
    "icon": "build/icon.ico",
    "target": [
      "nsis"
    ],

    "signingHashAlgorithms": [
      "sha256"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
