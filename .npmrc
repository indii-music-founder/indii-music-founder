engine-strict=false
; onnxruntime-node (pulled in by hyperframes) downloads a CUDA GPU binary from a
; GitHub release during install. That release asset now returns 404, which fails
; every `npm ci` with scripts (CI, local). Nothing in this repo uses the CUDA
; execution provider, so skip it; the CPU provider is unaffected.
; npm 11 warns that this key is unknown, and npm 12 may stop forwarding it. If the
; warning becomes an error, set ONNXRUNTIME_NODE_INSTALL_CUDA=skip in the install
; environment instead.
onnxruntime_node_install_cuda=skip
